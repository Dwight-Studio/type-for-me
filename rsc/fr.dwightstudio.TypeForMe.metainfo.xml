<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>fr.dwightstudio.TypeForMe</id>
    <name>Type for Me</name>
    <summary>Simple clipboard typer for Wayland, written in Rust</summary>
    <developer id="fr.dwightstudio">
        <name>Dwight Studio</name>
    </developer>
    <launchable type="desktop-id">fr.dwightstudio.TypeForMe.desktop</launchable>
    <project_license>GPL-3.0</project_license>
    <metadata_license>CC0-1.0</metadata_license>
    <content_rating type="oars-1.1"/>
    <url type="homepage">https://dwightstudio.fr/TypeForMe</url>
    <url type="bugtracker">https://github.com/Dwight-Studio/type-for-me/issues</url>
    <url type="vcs-browser">https://github.com/Dwight-Studio/type-for-me</url>
    <url type="help">http://discord.dwightstudio.fr</url>
    <recommends>
        <control>keyboard</control>
        <control>pointing</control>
    </recommends>
    <requires>
        <display_length compare="ge">360</display_length>
    </requires>
    <description>
        <p>`Type for Me` is a simple utility to type the content of your clipboard (instead of pasting it). It allows
            you to use
            your clipboard anywhere, even in virtual machines. It uses the built-in `Remote Desktop` features of modern
            Wayland
            compositor.
        </p>
    </description>
    <categories>
        <category>Development</category>
        <category>Utility</category>
    </categories>
    <keywords>
        <keyword>gtk4</keyword>
        <keyword>rust</keyword>
        <keyword>clipboard</keyword>
        <keyword>type</keyword>
        <keyword>for</keyword>
        <keyword>me</keyword>
        <keyword>wayland</keyword>
    </keywords>
    <kudos>
        <kudo>HiDpiIcon</kudo>
    </kudos>
    <screenshots>
    </screenshots>
    <releases>
        <release date="2024-10-09" version="1.0.0">
            <url type="details">https://github.com/Dwight-Studio/type-for-me/releases/tag/v1.0.0</url>
            <description>
                <p>Stable release of Type for Me</p>
                <p>Changelog:</p>
                <ul>
                    <li>Initial release!</li>
                </ul>
            </description>
        </release>
    </releases>
</component>